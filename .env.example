NODE_ENV=production
PUBLIC_URL=https://your-domain.example
PORT=3000
ADMIN_EMAIL=meilinheyhey@outlook.com
DB_PATH=/app/data/runtime/app.sqlite
APP_BUILD=1.0.0
# 在服务器配置，切勿提交真实值。
RESEND_API_KEY=
MAIL_FROM=胡桃法语 <hello@your-domain.example>
# 以下是可选银行卡适配器，正式采用国内支付时需另接持牌服务商。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

DOMAIN=your-domain.example

# 微信支付直连商户 Native 适配器（须确认已开通 Native，并绑定可用 AppID）
WECHATPAY_MCHID=1748656897
WECHATPAY_APPID=
WECHATPAY_SERIAL_NO=
WECHATPAY_PRIVATE_KEY_PATH=/run/secrets/wechat-apiclient-key.pem
WECHATPAY_API_V3_KEY=
WECHATPAY_PUBLIC_KEY_ID=
WECHATPAY_PUBLIC_KEY_PATH=/run/secrets/wechat-platform-public-key.pem

# 仅在应用端口不公开、由可信Caddy反代时启用
TRUST_PROXY=1
